# ==============================================================================
# ZEITNAH LMS BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to .env and configure the appropriate values for your environment.
# DO NOT commit the actual .env file to version control.

# --- SERVER SETTINGS ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://beta.zeitnahacademy.com
API_URL=https://beta.zeitnahacademy.com/api

# --- AUTHENTICATION & JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=60d
JWT_SESSION_EXPIRES_IN_MS=5184000000
JWT_REFRESH_EXPIRES_IN_MS=5184000000

# --- DATABASE ---
MONGO_URL=
MONGO_DB_NAME=lms-platform

# --- REDIS (UPSTASH / IOREDIS) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- THIRD-PARTY VIDEO HOSTING ---
VDOCIPHER_API_SECRET=

# --- EMAIL SERVICE (RESEND) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEV_TEAM_EMAIL=
ALERT_EMAIL=

# --- AWS S3 STORAGE ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zeitnahacademy-production
